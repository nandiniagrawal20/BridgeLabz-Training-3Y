/* Basic Styling */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  }

body {
font-family: Arial, sans-serif;
background-color: #f4f6f9;
color: #333;
}

/* Pricing Section */
.pricing-section {
padding: 60px 20px;
text-align: center;
}

.pricing-section h1 {
font-size: 36px;
margin-bottom: 10px;
}

.subtitle {
color: #666;
margin-bottom: 50px;
}

/* Flexbox Container */
.pricing-container {
display: flex;
justify-content: center;
align-items: center;
gap: 30px;
max-width: 1100px;
margin: 0 auto;
}

/* Pricing Cards */
.pricing-card {
flex: 1;
max-width: 320px;
min-width: 0;
min-height: 380px;
background-color: white;
padding: 35px 25px;
border-radius: 15px;
box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);

```
display: flex;
flex-direction: column;
justify-content: center;
align-items: center;
gap: 22px;

opacity: 0;
animation: fadeIn 0.8s ease forwards;
transition: transform 0.3s ease, box-shadow 0.3s ease;
```

}

/* Fade-in Animation */
@keyframes fadeIn {
from {
opacity: 0;
transform: translateY(20px);
}

```
to {
    opacity: 1;
    transform: translateY(0);
}
```

}

/* Staggered Animation */
.pricing-card:nth-child(1) {
animation-delay: 0.1s;
}

.pricing-card:nth-child(2) {
animation-delay: 0.3s;
}

.pricing-card:nth-child(3) {
animation-delay: 0.5s;
}

/* Highlight Middle Card */
.pricing-card.featured {
background-color: #2563eb;
color: white;
transform: scale(1.05);
}

.featured h3,
.featured h2 {
color: white;
}

.featured .badge {
background-color: white;
color: #2563eb;
padding: 7px 14px;
border-radius: 20px;
font-size: 12px;
font-weight: bold;
}

/* Prices */
.pricing-card h3 {
font-size: 30px;
color: #2563eb;
}

.pricing-card h3 span {
font-size: 14px;
font-weight: normal;
}

/* Features */
.pricing-card ul {
list-style: none;
line-height: 2;
}

/* Button */
.pricing-card button {
padding: 12px 22px;
background-color: #2563eb;
color: white;
border: none;
border-radius: 6px;
cursor: pointer;
}

.featured button {
background-color: white;
color: #2563eb;
}

/* Hover Effect */
.pricing-card:hover {
transform: translateY(-10px);
box-shadow: 0 12px 25px rgba(0, 0, 0, 0.2);
}

/* Responsive Layout */
@media (max-width: 750px) {
.pricing-container {
flex-direction: column;
}

```
.pricing-card {
    width: 100%;
    max-width: 400px;
}

.pricing-card.featured {
    transform: none;
}

.pricing-card:hover {
    transform: translateY(-10px);
}


}
