/* Basic Styling */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  }

body {
font-family: Arial, sans-serif;
background-color: #f4f4f4;
padding: 30px;
}

/* Main Heading */
h1 {
text-align: center;
margin-bottom: 30px;
color: #333;
}

/* Product Grid */
.product-grid {
display: grid;
grid-template-columns: repeat(4, 1fr);
gap: 20px;
align-items: stretch;
}

/* Product Cards */
.card {
background-color: white;
padding: 30px 20px;
border-radius: 10px;
text-align: center;
min-height: 180px;
display: flex;
flex-direction: column;
justify-content: center;
align-items: center;
gap: 15px;
box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
transition: 0.3s;
}

/* Hover Effect */
.card:hover {
transform: scale(1.05);
}

/* Product Name */
.card h2 {
font-size: 20px;
color: #333;
}

/* Product Price */
.card p {
font-size: 18px;
color: #008000;
font-weight: bold;
}

/* Tablet: 2 Columns */
@media (max-width: 900px) {
.product-grid {
grid-template-columns: repeat(2, 1fr);
}
}

/* Mobile: 1 Column */
@media (max-width: 600px) {
body {
padding: 15px;
}

